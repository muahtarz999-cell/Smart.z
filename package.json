{
  "name": "business-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "node --test",
    "worker:build": "opennextjs-cloudflare build --dangerously-use-unsupported-next-version",
    "pages:build": "npm run worker:build",
    "worker:preview": "opennextjs-cloudflare preview",
    "preview": "opennextjs-cloudflare build --dangerously-use-unsupported-next-version && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --dangerously-use-unsupported-next-version && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.45.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "0.23.0",
    "next": "15.5.28",
    "pdfjs-dist": "^4.10.38",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "postcss": "$postcss",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
