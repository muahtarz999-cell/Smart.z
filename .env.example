# انسخ هذا الملف باسم .env.local وضع القيم الحقيقية فيه. لا تضع قيماً حقيقية في هذا الملف أبداً (يُرفع إلى git).
# في الإنتاج: Cloudflare Pages ← Settings ← Environment variables (كل ما ليس NEXT_PUBLIC_ يُضاف كـ Secret).

# ---- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xkvanpcsfihflonevszt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# سري، خادمي فقط: يستخدمه webhook الأعمال (Meta) ومسار رسائل WhatsApp الشخصي. لا تضف له NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- لوحة الإدارة (/admin): بريد المدير، أو أكثر مفصولة بفواصل. بدونه اللوحة مغلقة.
ADMIN_EMAILS=
# قفل الجهاز الواحد: اتركه فارغاً حتى يُثبَّت APK الذي يرسل رقم الجهاز من وضع القيادة، ثم اجعله true.
DEVICE_LOCK_STRICT=

# ---- الذكاء الاصطناعي
# Groq: الردود النصية + تحويل الصوت إلى نص (Whisper).
GROQ_API_KEY=
# مفاتيح Groq إضافية من حسابات أخرى (حتى خمسة). تُوزَّع الطلبات بينها، وإذا بلغ مفتاح حدّه
# أو رُفض انتقل الطلب فوراً إلى التالي. كل حساب يحتاج قبول شروط نموذج النطق مرة واحدة.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
# احتياطي للردود النصية فقط عند تعذر Groq.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_BACKUP=

# ---- الصوت السحابي (المفضّل). يكفي مزوّد واحد؛ غير المضبوط يُتجاهل.
# Groq (لهجة سعودية) يستخدم مفاتيح GROQ_API_KEY أعلاه. قد يطلب Groq قبول شروط النموذج مرة واحدة من لوحة التحكم.
# GROQ_TTS_DISABLED=true لإيقافه دون حذف المفتاح.
# GROQ_TTS_MODEL= (اختياري: نموذج النطق في Groq)
# Azure AI Speech: 0.5 مليون حرف مجاناً شهرياً.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Google Cloud Text-to-Speech (Chirp 3 HD): مليون حرف مجاناً شهرياً، يتطلب حساب فوترة.
GOOGLE_TTS_API_KEY=
# Gemini API (Google AI Studio): طبقة مجانية بحدود معدل.
GEMINI_API_KEY=
# اختياري
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_STYLE= (اختياري: توجيه أسلوب النطق)
# TTS_PROVIDER_ORDER=groq,azure,google,gemini

# ---- قراءة الصور والمستندات المصوّرة (اختياري؛ الافتراضي: Groq ثم Gemini ثم OpenRouter بالمفاتيح أعلاه)
# VISION_PROVIDER_ORDER=groq,gemini,openrouter
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GEMINI_VISION_MODEL=gemini-2.5-flash
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# ---- WhatsApp مسار الأعمال (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0

# ---- WhatsApp المسار الشخصي (خوادم Render، حتى 5)
# كل مفتاح 24 حرفاً عشوائياً على الأقل، ويطابق CLUSTER_NODE_KEY على الخادم نفسه.
# خادم بلا URL أو بلا KEY يُتجاهل.
RENDER_SERVER_1_URL=
RENDER_SERVER_1_KEY=
RENDER_SERVER_2_URL=
RENDER_SERVER_2_KEY=
RENDER_SERVER_3_URL=
RENDER_SERVER_3_KEY=
RENDER_SERVER_4_URL=
RENDER_SERVER_4_KEY=
RENDER_SERVER_5_URL=
RENDER_SERVER_5_KEY=
