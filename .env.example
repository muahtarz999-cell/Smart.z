# انسخ هذا الملف باسم .env.local وضع القيم الحقيقية فيه.
# لا تضع أسرارًا أو مفاتيح حقيقية هنا؛ هذا الملف مخصص للرفع إلى Git.

# ---- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- لوحة الإدارة وقفل الجهاز
ADMIN_EMAILS=
DEVICE_LOCK_STRICT=

# ---- الذكاء الاصطناعي
GROQ_API_KEY=your-groq-api-key
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_KEY_BACKUP=your-backup-openrouter-api-key

# ---- الصوت السحابي
# GROQ_TTS_DISABLED=true
# GROQ_TTS_MODEL=
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region
GOOGLE_TTS_API_KEY=your-google-tts-api-key
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_TTS_MODEL=
# GEMINI_TTS_STYLE=
# TTS_PROVIDER_ORDER=groq,azure,google,gemini,openrouter

# ---- قراءة الصور والمستندات المصوّرة
# VISION_PROVIDER_ORDER=groq,gemini,openrouter
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GEMINI_VISION_MODEL=gemini-2.5-flash
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# ---- WhatsApp مسار الأعمال (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0

# ---- WhatsApp المسار الشخصي (خوادم Render، حتى 5)
RENDER_SERVER_1_URL=
RENDER_SERVER_1_KEY=
RENDER_SERVER_2_URL=
RENDER_SERVER_2_KEY=
RENDER_SERVER_3_URL=
RENDER_SERVER_3_KEY=
RENDER_SERVER_4_URL=
RENDER_SERVER_4_KEY=
RENDER_SERVER_5_URL=
RENDER_SERVER_5_KEY=
