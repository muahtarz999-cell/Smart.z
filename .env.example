# انسخ هذا الملف باسم .env.local وضع القيم الحقيقية فيه (لا يُرفع لـ GitHub)

# توكن GitHub Models (Personal Access Token بصلاحية Models)
GITHUB_MODELS_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq key for assistant replies, Whisper transcription, and Arabic speech generation.
GROQ_API_KEY=

# WhatsApp Cloud API من Meta
WHATSAPP_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0

# Server-side secret only. Set in Cloudflare Pages secrets; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

